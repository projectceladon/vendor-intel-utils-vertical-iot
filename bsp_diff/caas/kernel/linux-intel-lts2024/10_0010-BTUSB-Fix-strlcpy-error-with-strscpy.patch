From eacffe3263d9ca563517e134b349d5e8b56550fc Mon Sep 17 00:00:00 2001
From: celadon <celadon@intel.com>
Date: Wed, 16 Jul 2025 09:15:09 +0000
Subject: [PATCH] BTUSB: Fix strlcpy error with strscpy

Tracked-On: OAM-XXXX
Change-Id: I5dfe60bf85fbedb319101f342804479cf90f27fc
Signed-off-by: Basanagouda Nagappa Koppad <Basanagouda.Nagappa.Koppad@intel.com>

diff --git a/include/sound/pcm.h b/include/sound/pcm.h
index c102af86bf30..cde591b8f671 100644
--- a/include/sound/pcm.h
+++ b/include/sound/pcm.h
@@ -14,6 +14,7 @@
 #include <linux/poll.h>
 #include <linux/mm.h>
 #include <linux/bitops.h>
+#include <linux/string.h>
 #include <linux/pm_qos.h>
 #include <linux/refcount.h>
 #include <linux/uio.h>
diff --git a/sound/usb/btusb/btusb_sco_snd_card.c b/sound/usb/btusb/btusb_sco_snd_card.c
index 16a6dbb608e1..6b50f4108860 100644
--- a/sound/usb/btusb/btusb_sco_snd_card.c
+++ b/sound/usb/btusb/btusb_sco_snd_card.c
@@ -17,6 +17,7 @@
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/types.h>
+#include <linux/string.h>
 #include <linux/usb.h>
 #include <linux/usbdevice_fs.h>
 #include <linux/version.h>
@@ -929,18 +930,18 @@ static int btusb_snd_card_create(struct btusb_data *data)
 	pcm->private_data = data;
 	pcm->info_flags = 0;
 	data->pcm = pcm;
-	strlcpy(pcm->name, "USB Bluetooth audio", sizeof(pcm->name));
+	strscpy(pcm->name, "USB Bluetooth audio", sizeof(pcm->name));
 	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_CAPTURE,
 					&btusb_isoc_capture_ops);
 	snd_pcm_set_ops(pcm, SNDRV_PCM_STREAM_PLAYBACK,
 					&btusb_isoc_playback_ops);
 	snd_pcm_lib_preallocate_pages_for_all(pcm,
 			SNDRV_DMA_TYPE_CONTINUOUS,
-			snd_dma_continuous_data(GFP_KERNEL),
+			NULL,
 			64 * 1024, 64 * 1024);
-	strlcpy(card->driver, "bt_audio_source", sizeof(card->driver));
-	strlcpy(card->shortname, card->driver, sizeof(card->shortname));
-	strlcpy(card->longname, "USB Bluetooth audio source",
+	strscpy(card->driver, "bt_audio_source", sizeof(card->driver));
+	strscpy(card->shortname, card->driver, sizeof(card->shortname));
+	strscpy(card->longname, "USB Bluetooth audio source",
 			sizeof(card->longname));
 
 	err = snd_card_register(card);
-- 
2.34.1

