From 8dcc8e6f897be1f7dae614b7fbcfcd3fdf54eb82 Mon Sep 17 00:00:00 2001
From: "Pan, Kris" <kris.pan@intel.com>
Date: Thu, 21 Aug 2025 08:13:09 +0000
Subject: [PATCH] usb-gadget: WA to fix mount EP0 race condition

Signed-off-by: Pan, Kris <kris.pan@intel.com>
---
 groups/usb-gadget/auto/auto_hal.in | 31 +++++++++++++++++++-----------
 1 file changed, 20 insertions(+), 11 deletions(-)

diff --git a/groups/usb-gadget/auto/auto_hal.in b/groups/usb-gadget/auto/auto_hal.in
index af8446c..afe8d43 100644
--- a/groups/usb-gadget/auto/auto_hal.in
+++ b/groups/usb-gadget/auto/auto_hal.in
@@ -1,19 +1,28 @@
 update_usb_controller() {
-case "$(cat /sys/class/dmi/id/chassis_vendor | head -1)" in 
-	QEMU)
-		setprop vendor.usb.controller "dwc3.2.auto"
-		;;
-	*)
-		setprop vendor.usb.controller "dwc3.1.auto"
-		;;
+case "$(cat /sys/class/dmi/id/chassis_vendor | head -1)" in
+        QEMU)
+                setprop vendor.usb.controller "dwc3.2.auto"
+                ;;
+        *)
+                setprop vendor.usb.controller "dwc3.1.auto"
+                ;;
 esac
 }
 update_usb_controller
 
 vendor_mount_EP0() {
-DIR="/sys/class/udc/"
-if [ ! -z $(ls -A $DIR) ]; then
-        setprop vendor.mount.ep0 1
-fi
+    DIR="/sys/class/udc/"
+    TIMEOUT=10
+    COUNT=0
+
+    while [ $COUNT -lt $TIMEOUT ]; do
+        if [ ! -z "$(ls -A $DIR)" ]; then
+            setprop vendor.mount.ep0 1
+            return 0
+        fi
+        sleep 1
+        COUNT=$((COUNT + 1))
+    done
 }
+
 vendor_mount_EP0
-- 
